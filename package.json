{
  "name": "trainview",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:generate": "prisma generate",
    "db:setup": "prisma db push",
    "postinstall": "prisma generate",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "dev:demo": "TRAINVIEW_DEMO_MODE=true next dev",
    "test:smoke": "node scripts/smoke.mjs",
    "test:production": "node scripts/verify-production.mjs",
    "package:standalone": "node scripts/package-standalone.mjs",
    "test:standalone": "npm run package:standalone && node scripts/verify-production.mjs --standalone"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "fit-decoder": "^1.0.5",
    "lucide-react": "^0.546.0",
    "mapbox-gl": "^3.6.0",
    "next": "16.4.2",
    "prisma": "^6.18.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "recharts": "^3.3.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
