# Local SQLite monitoring database; never commit real fitness records.
DATABASE_URL="file:./dev.db"
# Absolute GarminDB HealthData path. Defaults to ./HealthData when omitted.
# GARMIN_DATA_ROOT="/absolute/path/to/HealthData"
# Optional: route maps
NEXT_PUBLIC_MAPBOX_TOKEN=""
# Optional: coaching sends training summaries and questions to OpenAI.
OPENAI_API_KEY=""
# Optional Chat Completions-compatible model; default preserves the original integration.
OPENAI_MODEL="gpt-4o-mini"

# Synthetic workouts without personal exports or live AI calls.
TRAINVIEW_DEMO_MODE=false
